# Public configuration only. Copy to .env.wechat-integration.local (gitignored).
# Never place AppSecret, merchant keys/certificates or database credentials here.
# Empty by design: obtain your own AppID and approved HTTPS domain.
VITE_APP_API_BASE=
VITE_WECHAT_APP_ID=
# HTTPS origins, comma-separated; request/uploadFile must include API origin.
WECHAT_REQUEST_DOMAINS=
WECHAT_UPLOAD_DOMAINS=
WECHAT_DOWNLOAD_DOMAINS=
# Explicit declarations only; the JSON will still say DECLARED_NOT_VERIFIED.
WECHAT_ICP_HTTPS_CONFIRMED=false
WECHAT_DOMAIN_CONSOLE_CONFIRMED=false
WECHAT_PRIVACY_CONFIRMED=false
WECHAT_CATEGORY_QUALIFICATIONS_CONFIRMED=false
WECHAT_SUBSCRIBE_CONFIRMED=false
WECHAT_PAYMENT_CONFIRMED=false
WECHAT_LOGIN_CONFIRMED=false
WECHAT_DEVICE_VALIDATION_CONFIRMED=false
